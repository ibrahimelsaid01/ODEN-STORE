@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<section style="margin-top: 100px; margin-bottom: 60px;">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-5 col-lg-6 col-md-8">

                <div class="card
                    shadow-lg
                    border-0
                    overflow-hidden"
                     style="border-radius: 20px;">

                    <div class="card-header
                        text-white
                        text-center
                        border-0
                        py-4"
                         style="background: linear-gradient(135deg, #6f42c1 0%, #4e2a84 100%);">

                        <h1 class="h3 fw-bold mb-2">
                            Forgot Your Password?
                        </h1>

                        <p class="mb-0 opacity-75">
                            Enter your email address to request a reset link.
                        </p>

                    </div>

                    <div class="card-body p-4 p-md-5">

                        <form method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger"
                                 role="alert">
                            </div>

                            <div class="form-floating mb-3">

                                <input asp-for="Input.Email"
                                       type="email"
                                       class="form-control"
                                       autocomplete="username"
                                       inputmode="email"
                                       maxlength="256"
                                       placeholder="name@example.com"
                                       required>

                                <label asp-for="Input.Email">
                                    Email Address
                                </label>

                                <span asp-validation-for="Input.Email"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="alert alert-light border mb-4"
                                 role="note">

                                <div class="d-flex gap-2">

                                    <i class="bi bi-shield-check"
                                       aria-hidden="true">
                                    </i>

                                    <div class="small">

                                        If an eligible account exists for this
                                        email address, password reset instructions
                                        will be sent.

                                    </div>

                                </div>

                            </div>

                            <button type="submit"
                                    class="btn
                                btn-lg
                                w-100
                                text-white
                                fw-semibold"
                                    style="background: #6f42c1;
                                border: none;
                                border-radius: 10px;">

                                Send Reset Link

                            </button>

                            <hr class="my-4">

                            <div class="text-center">

                                <p class="mb-0">

                                    Remember your password?

                                    <a asp-page="./Login"
                                       class="fw-semibold text-decoration-none"
                                       style="color: #6f42c1;">

                                        Back to sign in

                                    </a>

                                </p>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
@page
@model ResetPasswordConfirmationModel

@{
    ViewData["Title"] = "Password Reset Complete";
}

<section style="margin-top: 100px; margin-bottom: 60px;">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-5 col-lg-6 col-md-8">

                <div class="card
                    shadow-lg
                    border-0
                    overflow-hidden"
                     style="border-radius: 20px;">

                    <div class="card-header
                        text-white
                        text-center
                        border-0
                        py-4"
                         style="background: linear-gradient(135deg, #6f42c1 0%, #4e2a84 100%);">

                        <div class="mb-3">

                            <i class="bi bi-check-circle-fill"
                               aria-hidden="true"
                               style="font-size: 3rem;">
                            </i>

                        </div>

                        <h1 class="h3 fw-bold mb-2">
                            Password Reset Complete
                        </h1>

                        <p class="mb-0 opacity-75">
                            Your new password has been saved successfully.
                        </p>

                    </div>

                    <div class="card-body p-4 p-md-5">

                        <div class="text-center">

                            <div class="alert alert-success"
                                 role="status">

                                <i class="bi bi-shield-check me-1"
                                   aria-hidden="true">
                                </i>

                                Your password has been reset successfully.

                            </div>

                            <p class="text-muted mb-4">
                                You can now sign in to your ODEN STORE
                                account using your new password.
                            </p>

                            <a asp-page="./Login"
                               class="btn
                                btn-lg
                                w-100
                                text-white
                                fw-semibold"
                               style="background: #6f42c1;
                                border: none;
                                border-radius: 10px;">

                                <i class="bi bi-box-arrow-in-right me-1"
                                   aria-hidden="true">
                                </i>

                                Sign In

                            </a>

                            <hr class="my-4">

                            <a asp-area=""
                               asp-controller="Home"
                               asp-action="Index"
                               class="text-decoration-none">

                                <i class="bi bi-house-door me-1"
                                   aria-hidden="true">
                                </i>

                                Return to Home

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
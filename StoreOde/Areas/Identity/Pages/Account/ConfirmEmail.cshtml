@page
@model ConfirmEmailModel

@{
    ViewData["Title"] = Model.Succeeded
        ? "Email Confirmed"
        : "Email Confirmation";
}

<section style="margin-top: 100px; margin-bottom: 60px;">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-5 col-lg-6 col-md-8">

                <div class="card
                    shadow-lg
                    border-0
                    overflow-hidden"
                     style="border-radius: 20px;">

                    @if (Model.Succeeded)
                    {
                        <div class="card-header
                            text-white
                            text-center
                            border-0
                            py-4"
                             style="background: linear-gradient(135deg, #6f42c1 0%, #4e2a84 100%);">

                            <div class="mb-3">

                                <i class="bi bi-check-circle-fill"
                                   aria-hidden="true"
                                   style="font-size: 3rem;">
                                </i>

                            </div>

                            <h1 class="h3 fw-bold mb-2">
                                Email Confirmed
                            </h1>

                            <p class="mb-0 opacity-75">
                                Your account is ready to use.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="card-header
                            bg-danger
                            text-white
                            text-center
                            border-0
                            py-4">

                            <div class="mb-3">

                                <i class="bi bi-exclamation-triangle-fill"
                                   aria-hidden="true"
                                   style="font-size: 3rem;">
                                </i>

                            </div>

                            <h1 class="h3 fw-bold mb-2">
                                Confirmation Failed
                            </h1>

                            <p class="mb-0 opacity-75">
                                We couldn't confirm your email address.
                            </p>

                        </div>
                    }

                    <div class="card-body p-4 p-md-5">

                        @if (Model.Succeeded)
                        {
                            <div class="text-center">

                                <div class="alert alert-success"
                                     role="status">

                                    <i class="bi bi-shield-check me-1"
                                       aria-hidden="true">
                                    </i>

                                    @Model.StatusMessage

                                </div>

                                <p class="text-muted mb-4">
                                    You can now sign in to your
                                    ODEN STORE account.
                                </p>

                                <a asp-page="./Login"
                                   asp-route-returnUrl="@Model.ReturnUrl"
                                   class="btn
                                    btn-lg
                                    w-100
                                    text-white
                                    fw-semibold"
                                   style="background: #6f42c1;
                                    border: none;
                                    border-radius: 10px;">

                                    <i class="bi bi-box-arrow-in-right me-1"
                                       aria-hidden="true">
                                    </i>

                                    Sign In

                                </a>

                                <hr class="my-4">

                                <a asp-area=""
                                   asp-controller="Home"
                                   asp-action="Index"
                                   class="text-decoration-none">

                                    <i class="bi bi-arrow-left me-1"
                                       aria-hidden="true">
                                    </i>

                                    Return to Home

                                </a>

                            </div>
                        }
                        else
                        {
                            <div>

                                <div class="alert alert-danger"
                                     role="alert">

                                    @Model.StatusMessage

                                </div>

                                <p class="text-muted">
                                    This can happen if the confirmation
                                    link is invalid, incomplete, or no
                                    longer usable.
                                </p>

                                <div class="alert alert-light border"
                                     role="note">

                                    <div class="d-flex gap-2">

                                        <i class="bi bi-info-circle-fill"
                                           aria-hidden="true"
                                           style="color: #6f42c1;">
                                        </i>

                                        <div class="small">
                                            You can request another
                                            confirmation email and try again.
                                        </div>

                                    </div>

                                </div>

                                <a asp-page="./ResendEmailConfirmation"
                                   class="btn
                                    btn-lg
                                    w-100
                                    text-white
                                    fw-semibold
                                    mt-3"
                                   style="background: #6f42c1;
                                    border: none;
                                    border-radius: 10px;">

                                    <i class="bi bi-envelope-arrow-up me-1"
                                       aria-hidden="true">
                                    </i>

                                    Resend Confirmation Email

                                </a>

                                <div class="text-center mt-4">

                                    <a asp-page="./Login"
                                       asp-route-returnUrl="@Model.ReturnUrl"
                                       class="text-decoration-none">

                                        Back to Sign In

                                    </a>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
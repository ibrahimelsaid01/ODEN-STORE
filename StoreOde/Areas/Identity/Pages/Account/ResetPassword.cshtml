@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Reset Password";
}

<section style="margin-top: 100px; margin-bottom: 60px;">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-5 col-lg-6 col-md-8">

                <div class="card
                    shadow-lg
                    border-0
                    overflow-hidden"
                     style="border-radius: 20px;">

                    @if (Model.InvalidResetLink)
                    {
                        <div class="card-header
                            bg-danger
                            text-white
                            text-center
                            border-0
                            py-4">

                            <div class="mb-3">

                                <i class="bi bi-exclamation-triangle-fill"
                                   aria-hidden="true"
                                   style="font-size: 3rem;">
                                </i>

                            </div>

                            <h1 class="h3 fw-bold mb-2">
                                Invalid Reset Link
                            </h1>

                            <p class="mb-0 opacity-75">
                                This password reset link cannot be used.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="card-header
                            text-white
                            text-center
                            border-0
                            py-4"
                             style="background: linear-gradient(135deg, #6f42c1 0%, #4e2a84 100%);">

                            <div class="mb-3">

                                <i class="bi bi-key-fill"
                                   aria-hidden="true"
                                   style="font-size: 3rem;">
                                </i>

                            </div>

                            <h1 class="h3 fw-bold mb-2">
                                Reset Your Password
                            </h1>

                            <p class="mb-0 opacity-75">
                                Choose a new password for your account.
                            </p>

                        </div>
                    }

                    <div class="card-body p-4 p-md-5">

                        @if (Model.InvalidResetLink)
                        {
                            <div class="text-center">

                                <div class="alert alert-danger"
                                     role="alert">

                                    The password reset link is invalid,
                                    incomplete, or no longer usable.

                                </div>

                                <p class="text-muted mb-4">
                                    Request a new password reset link and
                                    use the most recent email you receive.
                                </p>

                                <a asp-page="./ForgotPassword"
                                   class="btn
                                    btn-lg
                                    w-100
                                    text-white
                                    fw-semibold"
                                   style="background: #6f42c1;
                                    border: none;
                                    border-radius: 10px;">

                                    <i class="bi bi-envelope-arrow-up me-1"
                                       aria-hidden="true">
                                    </i>

                                    Request New Reset Link

                                </a>

                                <hr class="my-4">

                                <a asp-page="./Login"
                                   class="text-decoration-none">

                                    <i class="bi bi-arrow-left me-1"
                                       aria-hidden="true">
                                    </i>

                                    Back to Sign In

                                </a>

                            </div>
                        }
                        else
                        {
                            <form method="post">

                                <input asp-for="Input.Code"
                                       type="hidden">

                                <div asp-validation-summary="ModelOnly"
                                     class="alert alert-danger"
                                     role="alert">
                                </div>

                                <div class="form-floating mb-3">

                                    <input asp-for="Input.Email"
                                           type="email"
                                           class="form-control"
                                           autocomplete="username"
                                           inputmode="email"
                                           maxlength="256"
                                           placeholder="name@example.com"
                                           required>

                                    <label asp-for="Input.Email">
                                        Email Address
                                    </label>

                                    <span asp-validation-for="Input.Email"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="form-floating mb-2">

                                    <input asp-for="Input.Password"
                                           class="form-control"
                                           autocomplete="new-password"
                                           minlength="10"
                                           maxlength="128"
                                           placeholder="New password"
                                           required>

                                    <label asp-for="Input.Password">
                                        New Password
                                    </label>

                                    <span asp-validation-for="Input.Password"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="small text-muted mb-3">

                                    Your new password must contain at least:

                                    <ul class="mb-0 mt-1 ps-4">

                                        <li>
                                            10 characters
                                        </li>

                                        <li>
                                            One uppercase letter
                                        </li>

                                        <li>
                                            One lowercase letter
                                        </li>

                                        <li>
                                            One number
                                        </li>

                                    </ul>

                                </div>

                                <div class="form-floating mb-4">

                                    <input asp-for="Input.ConfirmPassword"
                                           class="form-control"
                                           autocomplete="new-password"
                                           minlength="10"
                                           maxlength="128"
                                           placeholder="Confirm new password"
                                           required>

                                    <label asp-for="Input.ConfirmPassword">
                                        Confirm New Password
                                    </label>

                                    <span asp-validation-for="Input.ConfirmPassword"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="alert alert-light border"
                                     role="note">

                                    <div class="d-flex gap-2">

                                        <i class="bi bi-shield-lock-fill"
                                           aria-hidden="true"
                                           style="color: #6f42c1;">
                                        </i>

                                        <div class="small">
                                            After the password is reset,
                                            use the new password the next
                                            time you sign in.
                                        </div>

                                    </div>

                                </div>

                                <button type="submit"
                                        class="btn
                                    btn-lg
                                    w-100
                                    text-white
                                    fw-semibold
                                    mt-3"
                                        style="background: #6f42c1;
                                    border: none;
                                    border-radius: 10px;">

                                    <i class="bi bi-check-lg me-1"
                                       aria-hidden="true">
                                    </i>

                                    Reset Password

                                </button>

                                <hr class="my-4">

                                <div class="text-center">

                                    <a asp-page="./Login"
                                       class="text-decoration-none">

                                        Back to Sign In

                                    </a>

                                </div>

                            </form>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
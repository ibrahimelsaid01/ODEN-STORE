@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<section class="py-5">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-5 col-lg-6 col-md-8">

                <div class="card
                    border-0
                    shadow-lg
                    overflow-hidden"
                     style="border-radius: 20px;">

                    <div class="card-header
                        border-0
                        text-white
                        text-center
                        py-4"
                         style="background: linear-gradient(135deg, #6f42c1 0%, #4e2a84 100%);">

                        <h1 class="h3 fw-bold mb-2">
                            Welcome Back
                        </h1>

                        <p class="mb-0 opacity-75">
                            Sign in to your ODEN STORE account.
                        </p>

                    </div>

                    <div class="card-body p-4 p-md-5">

                        <form id="account"
                              method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger"
                                 role="alert">
                            </div>

                            <div class="form-floating mb-3">

                                <input asp-for="Input.Email"
                                       class="form-control"
                                       autocomplete="username"
                                       inputmode="email"
                                       maxlength="256"
                                       placeholder="name@example.com"
                                       required>

                                <label asp-for="Input.Email">
                                    Email Address
                                </label>

                                <span asp-validation-for="Input.Email"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="form-floating mb-3">

                                <input asp-for="Input.Password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       maxlength="128"
                                       placeholder="Password"
                                       required>

                                <label asp-for="Input.Password">
                                    Password
                                </label>

                                <span asp-validation-for="Input.Password"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="d-flex
                                flex-column
                                flex-sm-row
                                justify-content-between
                                align-items-sm-center
                                gap-2
                                mb-4">

                                <div class="form-check">

                                    <input asp-for="Input.RememberMe"
                                           class="form-check-input">

                                    <label asp-for="Input.RememberMe"
                                           class="form-check-label">

                                        @Html.DisplayNameFor(
                                            model =>
                                                model.Input.RememberMe)

                                    </label>

                                </div>

                                <a id="forgot-password"
                                   asp-page="./ForgotPassword"
                                   class="text-decoration-none"
                                   style="color: #6f42c1;">

                                    Forgot your password?

                                </a>

                            </div>

                            <button id="login-submit"
                                    type="submit"
                                    class="btn
                                btn-lg
                                w-100
                                text-white
                                fw-semibold"
                                    style="background: #6f42c1; border: none; border-radius: 10px;">

                                Sign In

                            </button>

                            <hr class="my-4">

                            <div class="text-center">

                                <p class="mb-2">

                                    Don't have an account?

                                    <a asp-page="./Register"
                                       asp-route-returnUrl="@Model.ReturnUrl"
                                       class="fw-semibold text-decoration-none"
                                       style="color: #6f42c1;">

                                        Create an account

                                    </a>

                                </p>

                                <p class="small mb-0">

                                    Didn't receive your confirmation email?

                                    <a id="resend-confirmation"
                                       asp-page="./ResendEmailConfirmation"
                                       class="text-decoration-none">

                                        Resend confirmation

                                    </a>

                                </p>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
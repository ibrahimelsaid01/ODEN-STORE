@model IReadOnlyList<StoreOde.Models.Category>

@{
    ViewData["Title"] = "Category Management";
}

<section class="section-bg py-5">

    <div class="container"
         data-aos="fade-up">

        <div class="d-flex
            flex-column
            flex-md-row
            justify-content-between
            align-items-md-center
            gap-3
            mb-4">

            <div>

                <h1 class="h2 mb-1"
                    style="color: #341f97;">
                    Category Management
                </h1>

                <p class="text-muted mb-0">
                    Manage the categories used to organize products
                    throughout the store.
                </p>

            </div>

            <div>

                <a asp-area=""
                   asp-controller="Categories"
                   asp-action="Create"
                   class="btn text-white px-4"
                   style="background: #5f27cd;">

                    <i class="bi bi-plus-lg me-1"
                       aria-hidden="true">
                    </i>

                    Create Category

                </a>

            </div>

        </div>

        @if (Model.Count == 0)
        {
            <div class="bg-white
                shadow-sm
                rounded-3
                text-center
                p-5">

                <i class="bi bi-tags"
                   aria-hidden="true"
                   style="font-size: 3rem; color: #5f27cd;">
                </i>

                <h2 class="h4 mt-3">
                    No categories found
                </h2>

                <p class="text-muted mb-4">
                    Create the first category before organizing
                    products in the catalog.
                </p>

                <a asp-area=""
                   asp-controller="Categories"
                   asp-action="Create"
                   class="btn text-white px-4"
                   style="background: #5f27cd;">

                    Create Your First Category

                </a>

            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">

                <div class="card-header
                    bg-white
                    d-flex
                    justify-content-between
                    align-items-center
                    py-3">

                    <h2 class="h5 mb-0">
                        Categories
                    </h2>

                    <span class="badge bg-secondary">

                        @Model.Count
                        @(Model.Count == 1 ? "category" : "categories")

                    </span>

                </div>

                <div class="table-responsive">

                    <table class="table
                        table-hover
                        align-middle
                        mb-0">

                        <thead class="table-light">

                            <tr>

                                <th scope="col">
                                    ID
                                </th>

                                <th scope="col">
                                    Category
                                </th>

                                <th scope="col">
                                    Description
                                </th>

                                <th scope="col">
                                    Icon
                                </th>

                                <th scope="col"
                                    class="text-end">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var category in Model)
                            {
                                var categoryName =
                                    string.IsNullOrWhiteSpace(category.Name)
                                        ? "Unnamed Category"
                                        : category.Name.Trim();

                                var description =
                                    string.IsNullOrWhiteSpace(category.Description)
                                        ? null
                                        : category.Description.Trim();

                                var shortDescription =
                                    description is not null &&
                                    description.Length > 120
                                        ? $"{description[..120]}..."
                                        : description;

                                var iconClass =
                                    string.IsNullOrWhiteSpace(category.IconClass)
                                        ? null
                                        : category.IconClass.Trim();

                                var requiresAttention =
                                    string.IsNullOrWhiteSpace(category.Name);

                                <tr>

                                    <td class="text-muted">
                                        @category.Id
                                    </td>

                                    <td>

                                        <div class="d-flex
                                            align-items-center
                                            gap-2">

                                            <span class="fw-semibold">
                                                @categoryName
                                            </span>

                                            @if (requiresAttention)
                                            {
                                                <span class="badge
                                                    bg-warning
                                                    text-dark">
                                                    Needs attention
                                                </span>
                                            }

                                        </div>

                                    </td>

                                    <td style="min-width: 240px;">

                                        @if (shortDescription is null)
                                        {
                                            <span class="text-muted">
                                                No description
                                            </span>
                                        }
                                        else
                                        {
                                            <span title="@description">
                                                @shortDescription
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (iconClass is not null)
                                        {
                                            <div class="d-flex
                                                align-items-center
                                                gap-2">

                                                <i class="@iconClass"
                                                   aria-hidden="true"
                                                   style="font-size: 1.4rem; color: #5f27cd;">
                                                </i>

                                                <code>
                                                    @iconClass
                                                </code>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Not configured
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <div class="d-flex
                                            justify-content-end
                                            gap-2">

                                            <a asp-area=""
                                               asp-controller="Categories"
                                               asp-action="Details"
                                               asp-route-id="@category.Id"
                                               class="btn
                                                btn-sm
                                                btn-outline-secondary"
                                               title="View category details">

                                                <i class="bi bi-eye"
                                                   aria-hidden="true">
                                                </i>

                                                <span class="visually-hidden">
                                                    View @categoryName
                                                </span>

                                            </a>

                                            <a asp-area=""
                                               asp-controller="Categories"
                                               asp-action="Edit"
                                               asp-route-id="@category.Id"
                                               class="btn
                                                btn-sm
                                                btn-outline-primary"
                                               title="Edit category">

                                                <i class="bi bi-pencil"
                                                   aria-hidden="true">
                                                </i>

                                                <span class="visually-hidden">
                                                    Edit @categoryName
                                                </span>

                                            </a>

                                            <a asp-area=""
                                               asp-controller="Categories"
                                               asp-action="Delete"
                                               asp-route-id="@category.Id"
                                               class="btn
                                                btn-sm
                                                btn-outline-danger"
                                               title="Delete category">

                                                <i class="bi bi-trash"
                                                   aria-hidden="true">
                                                </i>

                                                <span class="visually-hidden">
                                                    Delete @categoryName
                                                </span>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }

    </div>

</section>
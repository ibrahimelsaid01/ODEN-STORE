@model StoreOde.Models.Category

@{
    ViewData["Title"] = "Category Details";

    var categoryName =
        string.IsNullOrWhiteSpace(Model.Name)
            ? $"Category #{Model.Id}"
            : Model.Name.Trim();

    var description =
        string.IsNullOrWhiteSpace(Model.Description)
            ? null
            : Model.Description.Trim();

    var iconClass =
        string.IsNullOrWhiteSpace(Model.IconClass)
            ? null
            : Model.IconClass.Trim();

    var requiresAttention =
        string.IsNullOrWhiteSpace(Model.Name);
}

<section class="section-bg py-5">

    <div class="container"
         data-aos="fade-up">

        <div class="d-flex
            flex-column
            flex-lg-row
            justify-content-between
            align-items-lg-center
            gap-3
            mb-4">

            <div>

                <div class="d-flex
                    flex-wrap
                    align-items-center
                    gap-2
                    mb-1">

                    <h1 class="h2 mb-0"
                        style="color: #341f97;">
                        @categoryName
                    </h1>

                    @if (requiresAttention)
                    {
                        <span class="badge bg-warning text-dark">
                            Needs attention
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            Healthy
                        </span>
                    }

                </div>

                <p class="text-muted mb-0">
                    Category ID: @Model.Id
                </p>

            </div>

            <div class="d-flex flex-wrap gap-2">

                <a asp-area=""
                   asp-controller="Categories"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"
                       aria-hidden="true">
                    </i>

                    Back to Categories

                </a>

                <a asp-area=""
                   asp-controller="Categories"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">

                    <i class="bi bi-pencil me-1"
                       aria-hidden="true">
                    </i>

                    Edit

                </a>

                <a asp-area=""
                   asp-controller="Categories"
                   asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger">

                    <i class="bi bi-trash me-1"
                       aria-hidden="true">
                    </i>

                    Delete

                </a>

            </div>

        </div>

        @if (requiresAttention)
        {
            <div class="alert alert-warning"
                 role="alert">

                <div class="fw-semibold mb-1">
                    This category contains incomplete data.
                </div>

                <div>
                    A valid category name should be configured before
                    the final database cleanup.
                </div>

            </div>
        }

        <div class="row g-4">

            <div class="col-lg-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-header bg-white py-3">

                        <h2 class="h5 mb-0">
                            Category Icon
                        </h2>

                    </div>

                    <div class="card-body">

                        <div class="d-flex
                            flex-column
                            justify-content-center
                            align-items-center
                            text-center
                            bg-light
                            rounded-3
                            p-5"
                             style="min-height: 300px;">

                            @if (iconClass is not null)
                            {
                                <i class="@iconClass"
                                   aria-hidden="true"
                                   style="font-size: 5rem; color: #5f27cd;">
                                </i>

                                <h3 class="h6 mt-3">
                                    @categoryName
                                </h3>
                            }
                            else
                            {
                                <i class="bi bi-tag"
                                   aria-hidden="true"
                                   style="font-size: 5rem; color: #6c757d;">
                                </i>

                                <h3 class="h6 mt-3">
                                    No category icon
                                </h3>

                                <p class="small text-muted mb-0">
                                    No Bootstrap Icon class is configured
                                    for this category.
                                </p>
                            }

                        </div>

                        @if (iconClass is not null)
                        {
                            <div class="mt-3">

                                <div class="small text-muted mb-1">
                                    Icon Class
                                </div>

                                <code class="text-break">
                                    @iconClass
                                </code>

                            </div>
                        }

                    </div>

                </div>

            </div>

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm">

                    <div class="card-header bg-white py-3">

                        <h2 class="h5 mb-0">
                            Category Information
                        </h2>

                    </div>

                    <div class="card-body">

                        <div class="row g-4">

                            <div class="col-md-6">

                                <div class="small text-muted mb-1">
                                    Category Name
                                </div>

                                @if (string.IsNullOrWhiteSpace(Model.Name))
                                {
                                    <span class="badge bg-warning text-dark">
                                        Missing
                                    </span>
                                }
                                else
                                {
                                    <div class="fw-semibold">
                                        @categoryName
                                    </div>
                                }

                            </div>

                            <div class="col-md-6">

                                <div class="small text-muted mb-1">
                                    Category ID
                                </div>

                                <div>
                                    @Model.Id
                                </div>

                            </div>

                            <div class="col-12">

                                <div class="small text-muted mb-1">
                                    Description
                                </div>

                                @if (description is null)
                                {
                                    <div class="text-muted">
                                        No description provided.
                                    </div>
                                }
                                else
                                {
                                    <div style="white-space: pre-wrap;">@description</div>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
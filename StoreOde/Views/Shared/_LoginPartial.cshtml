@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item auth-nav-item">

        <a class="nav-link account-nav-link"
           asp-area="Identity"
           asp-page="/Account/Manage/Index"
           title="Manage your account"
           aria-label="Manage your account">

            <i class="bi bi-person-circle"
               aria-hidden="true">
            </i>

            <span>
                Account
            </span>

        </a>

    </li>

    <li class="nav-item auth-nav-item">

        <form asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Action(
                              "Index",
                              "Home",
                              new { area = "" })"
              method="post"
              class="logout-nav-form">

            <button type="submit"
                    class="nav-link logout-nav-button">

                <i class="bi bi-box-arrow-right"
                   aria-hidden="true">
                </i>

                <span>
                    Logout
                </span>

            </button>

        </form>

    </li>
}
else
{
    <li class="nav-item auth-nav-item">

        <a class="nav-link auth-register-link"
           asp-area="Identity"
           asp-page="/Account/Register">

            Register

        </a>

    </li>

    <li class="nav-item auth-nav-item">

        <a class="nav-link auth-login-link"
           asp-area="Identity"
           asp-page="/Account/Login">

            Login

        </a>

    </li>
}
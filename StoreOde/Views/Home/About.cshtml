@{
    ViewData["Title"] = "About Us";
}

<section class="about-page">

    <div class="container">

        <!-- ======= About Header ======= -->

        <div class="about-page-header text-center">

            <span class="about-page-label">
                ODEN STORE
            </span>

            <h1>
                About ODEN STORE
            </h1>

            <p>
                Premium Sportswear For Every Athlete
            </p>

        </div>

        <!-- ======= About Content ======= -->

        <div class="row
            align-items-stretch
            g-4
            g-lg-5
            about-showcase">

            <!-- Image -->

            <div class="col-lg-6 d-flex">

                <div class="about-image-card w-100">

                    <img src="~/assets/img/99.jpeg"
                         asp-append-version="true"
                         class="about-store-image"
                         alt="ODEN Store sportswear">

                </div>

            </div>

            <!-- Content -->

            <div class="col-lg-6 d-flex">

                <div class="about-content-card w-100">

                    <div class="about-content-heading">

                        <span class="about-content-label">
                            Our Story
                        </span>

                        <h2>
                            Who We Are
                        </h2>

                    </div>

                    <div class="about-description">

                        <p>
                            ODEN STORE is a modern sportswear brand dedicated to
                            providing high-quality clothing and accessories for men,
                            women, and children.
                        </p>

                        <p>
                            We carefully select products from leading international
                            brands to ensure comfort, durability, and style.
                        </p>

                        <p>
                            Our mission is to help athletes and fitness enthusiasts
                            achieve their goals while looking their best.
                        </p>

                    </div>

                    <!-- Features -->

                    <div class="row g-3 about-feature-grid">

                        <div class="col-sm-6">

                            <div class="about-feature-item">

                                <div class="about-feature-icon">

                                    <i class="bi bi-patch-check"
                                       aria-hidden="true">
                                    </i>

                                </div>

                                <div>

                                    <h3>
                                        Premium Quality
                                    </h3>

                                    <p>
                                        Premium Quality Products
                                    </p>

                                </div>

                            </div>

                        </div>

                        <div class="col-sm-6">

                            <div class="about-feature-item">

                                <div class="about-feature-icon">

                                    <i class="bi bi-tags"
                                       aria-hidden="true">
                                    </i>

                                </div>

                                <div>

                                    <h3>
                                        Trusted Brands
                                    </h3>

                                    <p>
                                        Trusted Global Brands
                                    </p>

                                </div>

                            </div>

                        </div>

                        <div class="col-sm-6">

                            <div class="about-feature-item">

                                <div class="about-feature-icon">

                                    <i class="bi bi-shield-check"
                                       aria-hidden="true">
                                    </i>

                                </div>

                                <div>

                                    <h3>
                                        Secure Shopping
                                    </h3>

                                    <p>
                                        Secure Shopping Experience
                                    </p>

                                </div>

                            </div>

                        </div>

                        <div class="col-sm-6">

                            <div class="about-feature-item">

                                <div class="about-feature-icon">

                                    <i class="bi bi-headset"
                                       aria-hidden="true">
                                    </i>

                                </div>

                                <div>

                                    <h3>
                                        Customer Support
                                    </h3>

                                    <p>
                                        Fast Customer Support
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- CTA -->

                    <div class="about-actions">

                        <a asp-controller="Home"
                           asp-action="Products"
                           class="about-primary-button">

                            Browse Products

                            <i class="bi bi-arrow-right"
                               aria-hidden="true">
                            </i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
@model IReadOnlyList<StoreOde.Models.Product>

@{
    var categoryName =
        ViewBag.CategoryName as string;

    var isAllProducts =
        string.IsNullOrWhiteSpace(categoryName) ||
        string.Equals(
            categoryName,
            "All Products",
            StringComparison.OrdinalIgnoreCase);

    var heading =
        isAllProducts
            ? "All Products"
            : $"{categoryName} Products";

    ViewData["Title"] = heading;
}

<section id="products"
         class="services section-bg">

    <div class="container"
         data-aos="fade-up">

        <div class="section-title">

            <h2 style="color: #341f97;">
                @heading
            </h2>

            @if (Model.Count > 0)
            {
                <p>
                    Browse @Model.Count
                    @(Model.Count == 1 ? "product" : "products")
                    currently available in this selection.
                </p>
            }

        </div>

        @if (Model.Count > 0)
        {
            <div class="row gy-4 mt-2">

                @foreach (var product in Model)
                {
                    <partial name="_ProductsPartial"
                             model="product" />
                }

            </div>
        }
        else
        {
            <div class="row justify-content-center">

                <div class="col-lg-7">

                    <div class="text-center bg-white shadow-sm rounded-3 p-5">

                        <i class="bi bi-box-seam"
                           aria-hidden="true"
                           style="font-size: 3rem; color: #5f27cd;">
                        </i>

                        <h3 class="mt-3">
                            No products found
                        </h3>

                        <p class="text-muted mb-4">

                            @if (isAllProducts)
                            {
                                <text>
                                    There are currently no products available.
                                </text>
                            }
                            else
                            {
                                <text>
                                    There are currently no products available
                                    in the @categoryName category.
                                </text>
                            }

                        </p>

                        <a asp-area=""
                           asp-controller="Home"
                           asp-action="Products"
                           class="btn px-4 text-white"
                           style="background: #5f27cd;">

                            View All Products

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</section>
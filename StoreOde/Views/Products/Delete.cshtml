@model StoreOde.Models.Product

@{
    ViewData["Title"] = "Delete Product";

    var productName =
        string.IsNullOrWhiteSpace(Model.Name)
            ? $"Product #{Model.Id}"
            : Model.Name.Trim();

    var categoryName =
        !string.IsNullOrWhiteSpace(Model.Cat?.Name)
            ? Model.Cat.Name.Trim()
            : Model.Catid > 0
                ? $"Category #{Model.Catid}"
                : "Unassigned";

    var supplierName =
        string.IsNullOrWhiteSpace(Model.SupplierName)
            ? "Not specified"
            : Model.SupplierName.Trim();

    var hasValidDiscount =
        Model.Price > 0 &&
        Model.Priceafterdiscount.HasValue &&
        Model.Priceafterdiscount.Value >= 0 &&
        Model.Priceafterdiscount.Value < Model.Price;

    var currentPrice =
        hasValidDiscount
            ? Model.Priceafterdiscount!.Value
            : Model.Price;
}

<section class="section-bg py-5">

    <div class="container"
         data-aos="fade-up">

        <div class="row justify-content-center">

            <div class="col-xl-8 col-lg-9">

                <div class="mb-4">

                    <a asp-area=""
                       asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-1"
                           aria-hidden="true">
                        </i>

                        Back to Products

                    </a>

                </div>

                <div class="card border-danger shadow-sm">

                    <div class="card-header bg-danger text-white py-3">

                        <div class="d-flex align-items-center gap-3">

                            <i class="bi bi-exclamation-triangle-fill"
                               aria-hidden="true"
                               style="font-size: 1.8rem;">
                            </i>

                            <div>

                                <h1 class="h4 mb-1">
                                    Delete Product
                                </h1>

                                <p class="mb-0">
                                    This is a destructive operation.
                                </p>

                            </div>

                        </div>

                    </div>

                    <div class="card-body p-4 p-md-5">

                        <div class="alert alert-danger"
                             role="alert">

                            <h2 class="h5 alert-heading">
                                Are you sure you want to delete
                                @productName?
                            </h2>

                            <p class="mb-2">
                                Deleting the product permanently removes
                                it from the product catalog.
                            </p>

                            <p class="mb-0">
                                Associated product-image records may also
                                be removed. If the product is referenced
                                by cart data that prevents deletion, the
                                server will reject the operation instead.
                            </p>

                        </div>

                        <div class="card bg-light border-0 mb-4">

                            <div class="card-body">

                                <h2 class="h5 mb-4">
                                    Product Summary
                                </h2>

                                <div class="row g-4">

                                    <div class="col-md-6">

                                        <div class="small text-muted mb-1">
                                            Product
                                        </div>

                                        <div class="fw-semibold">
                                            @productName
                                        </div>

                                    </div>

                                    <div class="col-md-6">

                                        <div class="small text-muted mb-1">
                                            Product ID
                                        </div>

                                        <div>
                                            @Model.Id
                                        </div>

                                    </div>

                                    <div class="col-md-6">

                                        <div class="small text-muted mb-1">
                                            Category
                                        </div>

                                        @if (Model.Catid <= 0)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Unassigned
                                            </span>
                                        }
                                        else
                                        {
                                            <div>
                                                @categoryName
                                            </div>
                                        }

                                    </div>

                                    <div class="col-md-6">

                                        <div class="small text-muted mb-1">
                                            Supplier
                                        </div>

                                        <div>
                                            @supplierName
                                        </div>

                                    </div>

                                    <div class="col-md-6">

                                        <div class="small text-muted mb-1">
                                            Current Price
                                        </div>

                                        @if (Model.Price > 0)
                                        {
                                            <div class="fw-semibold">
                                                @currentPrice.ToString("N2")
                                                EGP
                                            </div>

                                            @if (hasValidDiscount)
                                            {
                                                <div class="small text-muted">

                                                    Original:
                                                    @Model.Price.ToString("N2")
                                                    EGP

                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not configured
                                            </span>
                                        }

                                    </div>

                                    <div class="col-md-6">

                                        <div class="small text-muted mb-1">
                                            Stock
                                        </div>

                                        @if (Model.Quantity <= 0)
                                        {
                                            <span class="badge bg-danger">
                                                Out of stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                @Model.Quantity items
                                            </span>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="alert alert-warning"
                             role="alert">

                            <div class="d-flex gap-2">

                                <i class="bi bi-info-circle-fill"
                                   aria-hidden="true">
                                </i>

                                <div>
                                    <strong>
                                        This action cannot be undone from
                                        this interface.
                                    </strong>

                                    Verify the product ID and name before
                                    continuing.
                                </div>

                            </div>

                        </div>

                        <form method="post"
                              asp-area=""
                              asp-controller="Products"
                              asp-action="Delete"
                              asp-route-id="@Model.Id">

                            <input type="hidden"
                                   asp-for="Id">

                            <div class="d-flex
                                flex-column-reverse
                                flex-sm-row
                                justify-content-end
                                gap-2
                                mt-4">

                                <a asp-area=""
                                   asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-outline-secondary px-4">

                                    Cancel

                                </a>

                                <button type="submit"
                                        class="btn btn-danger px-4">

                                    <i class="bi bi-trash me-1"
                                       aria-hidden="true">
                                    </i>

                                    Permanently Delete Product

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>
@model StoreOde.Models.Product

@{
    ViewData["Title"] = "Create Product";
}

<section class="section-bg py-5">

    <div class="container"
         data-aos="fade-up">

        <div class="row justify-content-center">

            <div class="col-xl-9 col-lg-10">

                <div class="d-flex
                    flex-column
                    flex-md-row
                    justify-content-between
                    align-items-md-center
                    gap-3
                    mb-4">

                    <div>

                        <h1 class="h2 mb-1"
                            style="color: #341f97;">
                            Create Product
                        </h1>

                        <p class="text-muted mb-0">
                            Add a new product to the store catalog.
                        </p>

                    </div>

                    <div>

                        <a asp-area=""
                           asp-controller="Products"
                           asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-1"
                               aria-hidden="true">
                            </i>

                            Back to Products

                        </a>

                    </div>

                </div>

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4 p-md-5">

                        <form method="post"
                              enctype="multipart/form-data"
                              asp-area=""
                              asp-controller="Products"
                              asp-action="Create">

                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger"
                                 role="alert">
                            </div>

                            <div class="row g-4">

                                <div class="col-12">

                                    <label asp-for="Name"
                                           class="form-label fw-semibold">

                                        Product Name

                                        <span class="text-danger"
                                              aria-hidden="true">
                                            *
                                        </span>

                                    </label>

                                    <input asp-for="Name"
                                           class="form-control"
                                           maxlength="@Product.NameMaxLength"
                                           autocomplete="off"
                                           placeholder="Enter product name"
                                           required>

                                    <span asp-validation-for="Name"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-12">

                                    <label asp-for="Description"
                                           class="form-label fw-semibold">
                                        Description
                                    </label>

                                    <textarea asp-for="Description"
                                              class="form-control"
                                              rows="5"
                                              maxlength="@Product.DescriptionMaxLength"
                                              placeholder="Describe the product">
                                    </textarea>

                                    <span asp-validation-for="Description"
                                          class="text-danger small">
                                    </span>

                                    <div class="form-text">
                                        Maximum @Product.DescriptionMaxLength characters.
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <label asp-for="Catid"
                                           class="form-label fw-semibold">

                                        Category

                                        <span class="text-danger"
                                              aria-hidden="true">
                                            *
                                        </span>

                                    </label>

                                    <select asp-for="Catid"
                                            asp-items="ViewBag.Catid"
                                            class="form-select"
                                            required>

                                        <option value="">
                                            Select a category
                                        </option>

                                    </select>

                                    <span asp-validation-for="Catid"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-md-6">

                                    <label asp-for="Type"
                                           class="form-label fw-semibold">
                                        Product Type
                                    </label>

                                    <input asp-for="Type"
                                           class="form-control"
                                           maxlength="@Product.TypeMaxLength"
                                           autocomplete="off"
                                           placeholder="e.g. Shoes, T-Shirt, Jacket">

                                    <span asp-validation-for="Type"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-md-6">

                                    <label asp-for="Price"
                                           class="form-label fw-semibold">

                                        Price

                                        <span class="text-danger"
                                              aria-hidden="true">
                                            *
                                        </span>

                                    </label>

                                    <div class="input-group">

                                        <input asp-for="Price"
                                               type="number"
                                               class="form-control"
                                               min="0.01"
                                               step="0.01"
                                               inputmode="decimal"
                                               placeholder="0.00"
                                               required>

                                        <span class="input-group-text">
                                            EGP
                                        </span>

                                    </div>

                                    <span asp-validation-for="Price"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-md-6">

                                    <label asp-for="Priceafterdiscount"
                                           class="form-label fw-semibold">
                                        Discounted Price
                                    </label>

                                    <div class="input-group">

                                        <input asp-for="Priceafterdiscount"
                                               type="number"
                                               class="form-control"
                                               min="0"
                                               step="0.01"
                                               inputmode="decimal"
                                               placeholder="Optional">

                                        <span class="input-group-text">
                                            EGP
                                        </span>

                                    </div>

                                    <span asp-validation-for="Priceafterdiscount"
                                          class="text-danger small">
                                    </span>

                                    <div class="form-text">
                                        Leave empty when the product has no discount.
                                        It cannot be greater than the original price.
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <label asp-for="Quantity"
                                           class="form-label fw-semibold">

                                        Stock Quantity

                                        <span class="text-danger"
                                              aria-hidden="true">
                                            *
                                        </span>

                                    </label>

                                    <input asp-for="Quantity"
                                           type="number"
                                           class="form-control"
                                           min="0"
                                           step="1"
                                           inputmode="numeric"
                                           placeholder="0"
                                           required>

                                    <span asp-validation-for="Quantity"
                                          class="text-danger small">
                                    </span>

                                    <div class="form-text">
                                        Use 0 when the product is currently
                                        out of stock.
                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <label asp-for="SupplierName"
                                           class="form-label fw-semibold">
                                        Supplier Name
                                    </label>

                                    <input asp-for="SupplierName"
                                           class="form-control"
                                           maxlength="@Product.SupplierNameMaxLength"
                                           autocomplete="organization"
                                           placeholder="Enter supplier name">

                                    <span asp-validation-for="SupplierName"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-12">

                                    <label for="ImageFile"
                                           class="form-label fw-semibold">
                                        Product Image
                                    </label>

                                    <input type="file"
                                           id="ImageFile"
                                           name="ImageFile"
                                           class="form-control"
                                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp">

                                    @Html.ValidationMessage(
                                        "ImageFile",
                                        null,
                                        new
                                        {
                                            @class =
                                                "text-danger small"
                                        })

                                    <div class="form-text">
                                        Optional. Accepted formats:
                                        JPG, JPEG, PNG, and WEBP.
                                        Maximum file size: 5 MB.
                                    </div>

                                </div>

                                <div class="col-12">

                                    <label asp-for="ReviewUrl"
                                           class="form-label fw-semibold">
                                        Review URL
                                    </label>

                                    <input asp-for="ReviewUrl"
                                           class="form-control"
                                           maxlength="@Product.ReviewUrlMaxLength"
                                           autocomplete="off"
                                           placeholder="Optional review reference">

                                    <span asp-validation-for="ReviewUrl"
                                          class="text-danger small">
                                    </span>

                                </div>

                            </div>

                            <hr class="my-4">

                            <div class="d-flex
                                flex-column-reverse
                                flex-sm-row
                                justify-content-end
                                gap-2">

                                <a asp-area=""
                                   asp-controller="Products"
                                   asp-action="Index"
                                   class="btn btn-outline-secondary px-4">

                                    Cancel

                                </a>

                                <button type="submit"
                                        class="btn text-white px-4"
                                        style="background: #5f27cd;">

                                    <i class="bi bi-plus-lg me-1"
                                       aria-hidden="true">
                                    </i>

                                    Create Product

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>